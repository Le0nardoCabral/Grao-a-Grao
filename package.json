{
  "name": "grao-a-grao-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de cashback para cafeterias — Grão a Grão",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/Server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "start": "node dist/src/Server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/Seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2", "cors": "^2.8.5", "dotenv": "^16.6.1",
    "express": "^5.1.0", "helmet": "^8.1.0", "zod": "^4.1.5", "bcryptjs": "^3.0.2", "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/node": "^22.18.6", "@types/jsonwebtoken": "^9.0.10",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.16.2", "tsx": "^4.20.5", "typescript": "^5.9.2"
  },
  "scarfSettings": {
    "enabled": false
  }
}
