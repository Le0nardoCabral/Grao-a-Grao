meta {
  name: Criar cliente
  type: http
  seq: 12
}
post {
  url: {{baseUrl}}/clientes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nome": "Cliente Demonstração",
    "email": "cliente.demo.{{$guid}}@grao.local",
    "telefone": "11999990000",
    "dataNascimento": "1995-05-17",
    "planoId": {{planoId}}
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const body = res.getBody();
    bru.setVar("clienteId", String(body.id));
  }
}

tests {
  test("status HTTP esperado", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
